    "/api/chat": {
      "post": {
        "description": "Server-sent events. Each frame is `data: <json>\\n\\n`; parse the JSON and narrow on `type`. `credits` and `conversation` always arrive first, then a run of `token` deltas, then `done`.  Failures that can still carry a real status code (auth, ownership, credits) are settled before the headers flush — so a 402 arrives as JSON, never as a frame inside a 200 stream.",
        "operationId": "ChatController_stream",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An SSE stream. The schema describes one decoded frame.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ChatConversationEventDto"
                    },
                    {
                      "$ref": "#/components/schemas/ChatCreditsEventDto"
                    },
                    {
                      "$ref": "#/components/schemas/ChatSavedEventDto"
                    },
                    {
                      "$ref": "#/components/schemas/ChatSourcesEventDto"
                    },
                    {
                      "$ref": "#/components/schemas/ChatTokenEventDto"
                    },
                    {
                      "$ref": "#/components/schemas/ChatDoneEventDto"
                    },
                    {
                      "$ref": "#/components/schemas/ChatErrorEventDto"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "402": {
            "description": "Out of credits — the frontend shows the top-up prompt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InsufficientCreditsDto"
                }
              }
            }
          },
          "403": {
            "description": "conversationId is unknown or belongs to another user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Send a message and stream the reply",
        "tags": [
          "chat"
        ]
      }
    },
