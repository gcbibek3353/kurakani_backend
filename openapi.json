  "info": {
    "title": "Kurakani API",
    "description": "Backend for the Kurakani chat app.\n\nAuth is a session cookie issued by Better Auth. Its own routes live under\n`/api/auth/*` and are handled by the Better Auth handler rather than a Nest\ncontroller, so they are not listed here — the frontend talks to them through\nthe `better-auth/react` client, which ships its own types.\n\nEvery route below is protected by a global guard: no cookie means 401,\nbefore the handler runs.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local backend (direct)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local frontend (proxied by Next.js)"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Set by Better Auth on sign-in."
      }
    },
    "schemas": {
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "cm4x2k9p0000abcdef"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "hi@hyperce.io"
          },
          "name": {
            "type": "string",
            "example": "Bivek"
          },
          "credits": {
            "type": "number",
            "description": "Remaining credits. One is spent per chat message; at 0 the chat endpoint answers 402.",
            "example": 25
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "credits"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 403
          },
          "message": {
            "type": "string",
            "example": "Conversation not found"
          },
          "error": {
            "type": "string",
            "example": "Forbidden"
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "SourceType": {
        "type": "string",
        "enum": [
          "PDF",
          "YOUTUBE",
          "WEB"
        ]
      },
      "IngestStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "PROCESSING",
          "READY",
          "FAILED"
        ]
      },
      "DocumentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "conversationId": {
            "type": "string"
          },
          "sourceType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SourceType"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IngestStatus"
              }
            ]
          },
          "filename": {
            "type": "string",
            "nullable": true
          },
          "sourceUrl": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true,
            "description": "Populated when status is FAILED — show it to the user verbatim."
          },
          "chunkCount": {
            "type": "number",
            "description": "Chunks embedded. Zero while pending."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "conversationId",
          "sourceType",
          "status",
          "chunkCount",
          "createdAt"
        ]
      },
      "IngestUrlDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "A YouTube link or any web page. The backend classifies it.",
            "example": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
          },
          "conversationId": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "conversationId"
        ]
      },
      "MemoryItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "mem0 id — pass to DELETE /api/memory/:id."
          },
          "memory": {
            "type": "string",
            "description": "The extracted fact, e.g. \"Is vegetarian\".",
            "example": "Prefers TypeScript over JavaScript"
          },
          "createdAt": {
            "type": "string",
            "description": "ISO timestamp, if mem0 recorded one."
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "memory"
        ]
      },
      "ChatMode": {
        "type": "string",
        "enum": [
          "NORMAL",
          "RAG"
        ]
      },
      "ConversationRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "Derived from the first message, 60 chars max."
          },
          "mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ChatMode"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "mode"
        ]
      },
      "ChatConversationEventDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "conversation"
            ]
          },
          "value": {
            "$ref": "#/components/schemas/ConversationRefDto"
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "ChatCreditsEventDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "credits"
            ]
          },
          "value": {
            "type": "number",
            "description": "Balance remaining after this turn was charged."
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "ChatSavedEventDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "saved"
            ]
          },
          "value": {
            "type": "string",
            "description": "Row id of the user turn. Pass it back as `fromMessageId` to replace this turn and everything after it."
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "SourceChunkDto": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "page": {
            "type": "number"
          },
          "score": {
            "type": "number",
            "description": "Cosine distance — lower is closer."
          },
          "excerpt": {
            "type": "string",
            "description": "The chunk text, truncated for display."
          }
        },
        "required": [
          "documentId",
          "title",
          "score",
          "excerpt"
        ]
      },
      "ChatSourcesEventDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "sources"
            ]
          },
          "value": {
            "description": "Chunks the answer was grounded in. Sent once, before any token.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceChunkDto"
            }
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "ChatTokenEventDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "token"
            ]
          },
          "value": {
            "type": "string",
            "description": "A text delta. Append it; do not replace."
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "ChatDoneEventDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "done"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "ChatErrorEventDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "ChatDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "The user turn. Must be non-empty after trimming.",
            "example": "Explain SSE in one paragraph."
          },
          "conversationId": {
            "type": "string",
            "description": "Omit to start a new conversation; the id comes back in the first SSE frame."
          },
          "fromMessageId": {
            "type": "string",
            "description": "Rewind the transcript: this message and everything after it are deleted before the new turn is written. Send the id of the user turn being replaced — with the same text to regenerate the reply, or with edited text to resend it. Requires conversationId."
          }
        },
        "required": [
          "message"
        ]
      },
      "InsufficientCreditsDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 402
          },
          "error": {
            "type": "string",
            "enum": [
              "INSUFFICIENT_CREDITS"
            ]
          },
          "message": {
            "type": "string",
            "example": "Out of credits"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      },
      "ConversationSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "example": "How do I set up Swagger in Nest?"
          },
          "mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ChatMode"
              }
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Bumped on every turn. The sidebar is ordered by this, descending."
          }
        },
        "required": [
          "id",
          "title",
          "mode",
          "updatedAt"
        ]
      },
      "CreateConversationDto": {
        "type": "object",
        "properties": {
          "mode": {
            "default": "NORMAL",
            "description": "RAG to start a chat that answers only from attached sources. Sources are attached after this call, with the id it returns.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ChatMode"
              }
            ]
          }
        }
      },
      "MessageRole": {
        "type": "string",
        "enum": [
          "USER",
          "ASSISTANT",
          "SYSTEM"
        ]
      },
      "MessageDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MessageRole"
              }
            ]
          },
          "content": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "role",
          "content",
          "createdAt"
        ]
      },
      "ConversationDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ChatMode"
              }
            ]
          },
          "messages": {
            "description": "Oldest first.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageDto"
            }
          },
          "shareToken": {
            "type": "string",
            "nullable": true,
            "description": "Set when an active share link exists. Owner-only — this endpoint is already scoped to the signed-in user."
          },
          "sharedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Snapshot cutoff of the current share link."
          }
        },
        "required": [
          "id",
          "title",
          "mode",
          "messages"
        ]
      },
      "ShareLinkDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Opaque token. The public URL is <frontend>/share/<token>.",
            "example": "2f6b1c30-9a4e-4c1d-8f21-6b0e3a7c5d99"
          },
          "sharedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Snapshot cutoff — messages sent after this are not published."
          }
        },
        "required": [
          "token",
          "sharedAt"
        ]
      },
      "SharedConversationDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "sharedAt": {
            "type": "string",
            "format": "date-time"
          },
          "messages": {
            "description": "Oldest first, and only those sent at or before sharedAt.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageDto"
            }
          }
        },
        "required": [
          "title",
          "sharedAt",
          "messages"
        ]
      },
      "CreditPackDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "starter"
          },
          "credits": {
            "type": "number",
            "description": "Credits granted once the payment is captured."
          },
          "amountPaise": {
            "type": "number",
            "description": "Price in paise — integer subunits, never a float. ₹99 is 9900.",
            "example": 9900
          }
        },
        "required": [
          "id",
          "credits",
          "amountPaise"
        ]
      },
      "CreditPackId": {
        "type": "string",
        "enum": [
          "starter",
          "plus",
          "pro"
        ],
        "description": "Which pack to buy. The server owns the price."
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "packId": {
            "description": "Which pack to buy. The server owns the price.",
            "example": "starter",
            "allOf": [
              {
                "$ref": "#/components/schemas/CreditPackId"
              }
            ]
          }
        },
        "required": [
          "packId"
        ]
      },
      "OrderDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "Razorpay order id. Pass as `order_id` to checkout.",
            "example": "order_MkT8xY2zAbCdEf"
          },
          "amountPaise": {
            "type": "number",
            "example": 9900
          },
          "credits": {
            "type": "number",
            "description": "Credits this purchase will grant, once captured."
          },
          "paymentId": {
            "type": "string",
            "description": "Local Payment row id. Useful for support; credits are granted by the webhook, never by the browser reporting success."
          }
        },
        "required": [
          "orderId",
          "amountPaise",
          "credits",
          "paymentId"
        ]
      }
    }
  }
}
